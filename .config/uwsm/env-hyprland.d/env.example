# Machine-specific Hyprland environment, sourced by uwsm (uwsm/env-hyprland.d/*)
# Copy to env and adjust for this machine. env is gitignored.

# Multi GPU https://wiki.hypr.land/Configuring/Multi-GPU/
# Need consistent symlinks first: run ./setup-gpu.sh
# export AQ_DRM_DEVICES=/dev/dri/card1:/dev/dri/card2
# export AQ_DRM_DEVICES=/dev/dri/nvidia:/dev/dri/intel

# Nvidia specific https://wiki.hypr.land/Configuring/Environment-variables/#nvidia-specific
# export AQ_FORCE_LINEAR_BLIT=0
# export AQ_MGPU_NO_EXPLICIT=1
# export AQ_NO_MODIFIERS=1
